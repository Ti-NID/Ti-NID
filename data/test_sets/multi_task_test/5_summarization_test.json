    "instruction": "གཤམ་གྱི་ཚན་པ་དེའི་ནང་དོན་གནད་བསྡུས་འབྲི་རོགས།",
    "input": "ཀྲུང་གོ་འི་བོད་ཀྱི་དྲ་བ་འི་འཕྲིན།ཟླ་༦ཚེས་༦ཉིན་གྱི་སྔ་དྲོ་ལྗོངས་ཡོངས་ཀྱི་མཐོ་སློབ་ཏང་འཛུགས་སྐྱོང་ལས་དོན་ཚོགས་འདུ་ལྷ་ས་ར་འཚོགས་པ་དང་རང་སྐྱོང་ལྗོངས་ཏང་ཨུད་ཀྱི་རྒྱུན་ལས་ཧྲུའུ་ཅི་གཞོན་པ་ལྗོངས་ཏང་ཨུད་ཀྱི་ཏང་འཛུགས་སྐྱོང་ལས་དོན་འགོ་ཁྲིད་ཚོགས་ཆུང་གི་ཙུའུ་ཀྲང་ཧའོ་ཕུང་ཚོགས་འདུ་ར་ཞུགས་པ་དང་འབྲེལ་གསུང་བཤད་ཀྱང་གནང་ཞིང་།ཁོང་གིས་ལྗོངས་ཡོངས་ཀྱི་མཐོ་རིམ་སློབ་གྲྭ་ས་ནུས་ཤུགས་ཡོད་རྒུ་ས་ཏང་རྩ་འཛུགས་དང་ཏང་ཡོན་དཔུང་ཁག་འཛུགས་སྐྱོང་ལ་ཤུགས་སྣོན་བརྒྱབ་ནས་མཐོ་རིམ་སློབ་གྲྭ་འི་ཚན་རིག་དང་མཐུན་པ་འི་འཕེལ་རྒྱས་ལ་སྐུལ་འདེད་གཏོང་བ་དང་།ལྗོངས་ཡོངས་ཀྱི་འཕེལ་རྒྱས་དང་བརྟན་ལྷིང་ལ་ཞབས་འདེགས་ཞུ་བ་ར་རྩ་འཛུགས་ཀྱི་ཐོག་ནས་འགན་ལེན་བརྟན་པོ་བྱེད་དགོས་ཞེས་ནན་བཤད་གནང་བ་རེད།ཧའོ་ཕུང་གིས་ཉེ་བ་འི་ལོ་ཤས་རིང་རང་སྐྱོང་ལྗོངས་ཏང་ཨུའི་ཚད་མཐོ་འི་མཐོང་ཆེན་དང་སྲ་བརྟན་འགོ་ཁྲིད་འོག་ལྗོངས་ཡོངས་ཀྱི་མཐོ་རིམ་སློབ་གྲྭ་ས་ཀྲུང་གོ་འི་ཁྱད་ཆོས་ཀྱི་སྤྱི་ཚོགས་རིང་ལུགས་བྱ་གཞག་གི་ཚད་དང་ལོན་པ་འི་འཛུགས་སྐྲུན་པ་དང་བློས་འཁེལ་བ་འི་རྒྱུད་འཛིན་པ་གསོ་སྐྱོང་གི་རྩ་བ་འི་ལས་འགན་དེར་དམ་པོ་ར་དམིགས་ནས་མཐོ་རིམ་སློབ་གྲྭ་འི་ཏང་གི་བསམ་བློ་དང་།རྩ་འཛུགས།སྤྱོད་ཚུལ།ལམ་ལུགས་བཅས་དང་རུལ་རྒོལ་གཙང་སྤེལ་འཛུགས་སྐྱོང་ལ་སྒོ་ཀུན་ནས་སྐུལ་མ་བཏང་བ་ས་དགེ་རྒན་དང་ལས་བཟོའི་ནང་གི་ཏང་ཡོན་དང་སློབ་མ་ཏང་ཡོན་གྱི་བསྡུར་ཚད་རྒྱུན་ཆད་མེད་པ་ར་ཆེ་རུ་སོང་བ་དང་།གཞི་རིམ་རྩ་འཛུགས་འཛུགས་སྐྱོང་བྱེད་པ་ར་ཤུགས་སྣོན་ནུས་ལྡན་ཐེབས་པ།དུས་བདེ་དང་ཞི་མཐུན་ལྡན་པ་འི་སློབ་གྲྭ་སྐྲུན་རྒྱུ་ར་ཕན་འབྲས་མངོན་གསལ་དོད་པོ་ཐོན་པ་བཅས་བྱས་ནས་ལྗོངས་ཡོངས་ཀྱི་མཐོ་རིམ་སློབ་གསོ་འི་བྱ་གཞག་འཕེལ་རྒྱས་ལ་ཚན་རིག་དང་མཐུན་པ་འི་ངང་སྐུལ་འདེད་གཏོང་བ་དང་བོད་ཀྱི་སྒྱུར་བཅོས་དང་།འཕེལ་རྒྱས།བརྟན་ལྷིང་བཅས་ལ་ཞབས་འདེགས་ཞུ་བ་ར་ལེགས་སྐྱེས་གལ་ཆེན་ཕུལ་ཡོད།ངས་རང་སྐྱོང་ལྗོངས་ཏང་ཨུད་དང་སྲིད་གཞུང་གི་ཚབ་ཞུས་ནས་ལྗོངས་ཡོངས་ཀྱི་མཐོ་སློབ་ཀྱི་རྒྱ་ཆེ་འི་དགེ་རྒན་དང་ལས་བཟོ་ཚོ་ར་སྙིང་དབུས་ནས་ཐུགས་རྗེ་ཆེ་ཞུ་རྒྱུ་ཡིན་ཞེས་གསུངས་པ་རེད།ཧའོ་ཕུང་གིས་ནན་བཤད་གནང་དོན།མཐོ་སློབ་ཀྱི་ཏང་རྩ་འཛུགས་ཀྱིས་སྤྱི་ཚོགས་རིང་ལུགས་བྱ་གཞག་གི་འཛུགས་སྐྲུན་པ་དང་རྒྱུན་འཛིན་པ་གསོ་སྐྱོང་བྱ་རྒྱུ་འི་ལོ་རྒྱུས་ཀྱི་འགན་འཁྲི་ལྕི་པོ་འཁུར་ཡོད།བོད་འདི་ཉིད་མཆོང་སྐྱོད་ལྟ་བུ་འི་འཕེལ་རྒྱས་དང་ཡུན་རིང་བདེ་འཁོད་ཡོང་མིན་དེ་མཐར་ང་ཚོ་ས་སེམས་པ་ཏང་དང་མེས་རྒྱལ་ལ་ཕྱོགས་པ་དང་།ཆབ་སྲིད་ཀྱི་བྱང་ཚད་མཐོ་བ།ཆེད་ལས་ནུས་པ་ཆེ་བ་བཅས་ཀྱི་ཕུལ་དུ་བྱུང་བ་འི་ཤེས་ལྡན་པ་འབོར་ཆེན་ཞིག་གསོ་སྐྱོང་ཐུབ་མིན་ལ་རག་ལུས་ཡོད།ལྗོངས་ཡོངས་ཀྱི་མཐོ་སློབ་ཏང་རྩ་འཛུགས་ཀྱིས་འགན་འཁྲི་འི་འདུ་ཤེས་དང་འགན་འཁུར་བསམ་པ་ཆེ་རུ་ཏན་ཏིག་གཏོང་བ་དངཀྲུང་གོ་གུང་ཁྲན་ཏང་གི་མཐོ་སློབ་དཀྱུས་མ་འི་སློབ་གྲྭ་འི་གཞི་རིམ་རྩ་འཛུགས་ཀྱི་ལས་དོན་སྲོལ་ཡིགདང་རང་ལྗོངས་ཀྱི་ལག་བསྟར་བསམ་འཆར་ནན་པོ་གཞིར་བཟུང་ལྗོངས་ཏང་ཨུད་དང་སྲིད་གཞུང་གི་ལྟེ་བ་འི་ལས་དོན་ལ་དམ་པོ་ར་དམིགས་ཏེ་བསམ་བློ་དང་།རྩ་འཛུགས།ཏང་ཡོན་དཔུང་ཁགཏང་དོན་ལས་བྱེད་པ་འི་དཔུང་ཁག་འཛུགས་སྐྱོང་སོགས་ཕྱོགས་ཁག་ཐད་ནས་མཐོ་སློབ་ཀྱི་ཏང་འཛུགས་སྐྱོང་ལས་དོན་ལ་སྔར་བ་ས་ཤུགས་སྣོན་རྒྱག་དགོས།ཏང་གི་ཚོགས་ཆེན་བཅོ་བརྒྱད་པ་རྒྱལ་ཁ་འི་ངང་འཚོག་རྒྱུ་ར་བསུ་བ་ཞུ་བ་དང་ཏང་གི་ཚོགས་ཆེན་བཅོ་བརྒྱད་པ་འི་དགོངས་དོན་སློབ་སྦྱོང་དང་།དྲིལ་བསྒྲགས།ལག་བསྟར་བཅས་བྱ་རྒྱུ་དེ་གཙོ་རྐང་དུ་བྱས་ནས་བསམ་བློ་ཆབ་སྲིད་འཛུགས་སྐྱོང་ལ་ཤུགས་སྣོན་རྒྱག་པ་དང་།གཞི་རིམ་རྩ་འཛུགས་འཛུགས་སྐྱོང་ལོ་དེ་གཞི་འཛིན་ས་ར་བྱས་ནས་གཞི་རིམ་ཏང་རྩ་འཛུགས་འཛུགས་སྐྱོང་ལ་ཤུགས་སྣོན་རྒྱག་པ།ཏང་གི་དམག་འཐབ་ནུས་པ་ཆེ་རུ་གཏོང་རྒྱུ་དང་ཏང་གི་སྔོན་ཐོན་རང་བཞིན་དང་དྭངས་གཙང་རང་བཞིན་རྒྱུན་འཁྱོངས་བྱ་རྒྱུ་དེ་དམིགས་ཡུལ་དུ་བྱས་ནས་ཏང་ཡོན་དཔུང་ཁག་འཛུགས་སྐྱོང་ལ་ཤུགས་སྣོན་རྒྱག་པ།ནུས་པ་དང་བྱང་ཚད་མཐོ་རུ་གཏོང་རྒྱུ་དེ་གཙོ་གནད་དུ་འཛིན་ནས་འགོ་ཁྲིད་ཚན་ཁག་དང་ཏང་དོན་ལས་བྱེད་པ་འི་དཔུང་ཁག་འཛུགས་སྐྱོང་ལ་ཤུགས་སྣོན་རྒྱག་པ་བཅས་བྱེད་དགོས།ཧའོ་ཕུང་གིས་གསུངས་དོན།ཏང་གི་སྐབས་བཅུ་བདུན་པ་འི་ཀྲུང་ཨུ་ཚང་འཛོམས་གྲོས་ཚོགས་ཐེངས་དྲུག་པ་འི་ཐོག་མཐོ་སློབ་ཀྱི་ཏང་འཛུགས་སྐྱོང་ལས་དོན་ཁྲོད་སྤྱི་ཚོགས་རིང་ལུགས་ཀྱི་ལྟེ་བ་འི་རིན་ཐང་མ་ལག་འཛུགས་སྐྱོང་ལ་སྐུལ་འདེད་གཏོང་བ་འི་ཐད་བླང་བྱ་གསལ་པོ་བཏོན་པ་ས་ང་ཚོ་ས་བོད་ཀྱི་དོན་དངོས་དང་ཟུང་འབྲེལ་དམ་ཟབ་བྱས་ནས་སྔོན་ཐོན་རིག་གནས་ཀྱི་སྣེ་ཁྲིད་ནུས་པ་འདོན་སྤེལ་ཡག་པོ་བྱས་ཐོག་སྤྱི་ཚོགས་རིང་ལུགས་ཀྱི་ལྟེ་བ་འི་རིན་ཐང་མ་ལག་འཛུགས་སྐྱོང་བྱ་རྒྱུ་དེ་མཐོ་རིམ་སློབ་གྲྭ་འི་སློབ་གསོ་དང་སློབ་ཁྲིད་དང་།བསམ་པ་འི་དཔལ་ཡོན་སྲོལ་གཏོད།ཏང་འཛུགས་སྐྱོང་བཅས་ཀྱི་བརྒྱུད་རིམ་ཧྲིལ་པོ་འི་ནང་ཁྱབ་པ་བྱས་ཏེ་མཐོ་སློབ་ནི་ལྗོངས་ཡོངས་སུ་ཁ་ཕྲལ་ལ་ངོ་རྒོལ་བྱེད་པ་འི་འཐབ་རྩོད་ཀྱི་སློབ་གསོ་རྒྱག་པ་དང་།རྒྱལ་གཅེས་རིང་ལུགས་ཀྱི་སྙིང་སྟོབས་སྐྱེད་སྲིང་བྱེད་པ།མི་རིགས་མཐུན་སྒྲིལ་ཡར་ཐོན་གསར་གཏོད་ཀྱི་བྱེད་སྒོ་ར་སྐུལ་མ་གཏོང་བ་བཅས་ཀྱི་དཔེ་སྟོན་ཁུལ་དང་ཁྱབ་ཁུངས་ཤིག་ཏུ་འགྱུར་བ་བྱེད་དག